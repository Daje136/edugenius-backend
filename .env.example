# ============================================================
# EduGenius Backend — Environment Variables
# Copy this file to .env and fill all values before deploying
# NEVER commit .env to version control
# ============================================================

# ─── SERVER ────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_64_char_random_string_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_64_char_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ─── MONGODB (Question Bank + Chat Logs) ───────────────────
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/edugenius?retryWrites=true&w=majority

# ─── POSTGRESQL (Users, Results, Goals, Assignments) ───────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=edugenius
PG_USER=edugenius_user
PG_PASSWORD=your_pg_password_here
PG_SSL=true

# ─── REDIS (Sessions + Cache) ──────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# ─── OPENAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1500

# ─── EMAIL (Nodemailer) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=EduGenius <noreply@edugenius.ng>

# ─── FILE UPLOAD ───────────────────────────────────────────
UPLOAD_MAX_MB=10
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=eu-west-1
AWS_S3_BUCKET=edugenius-uploads

# ─── FRONTEND ──────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ─── RATE LIMITING ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20
