{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🌱 Seed Nigerian Questions",
      "type": "shell",
      "command": "node src/seeders/seed.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🇬🇧 Seed UK/GCSE Questions",
      "type": "shell",
      "command": "node src/seeders/seedUKQuestions.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "📥 Import Aloc Questions",
      "type": "shell",
      "command": "node src/seeders/importAloc.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🚀 Start Server",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🔄 Seed ALL Questions",
      "type": "shell",
      "command": "node src/seeders/seed.js && node src/seeders/seedUKQuestions.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}